              <OBJECT>
                <ID name="" mc="Infrastructure.Note" uid="b8e8772d-d94c-445f-8de5-358a35fdc14d"/>
                <ATTRIBUTES>
                  <ATT name="Content"><![CDATA[String sql = "UPDATE menu_items " +
        "SET name = ?, description = ?, price = ?, is_available = ? " +
        "WHERE id = ?";

try (Connection conn = getConnection();
        PreparedStatement ps = conn.prepareStatement(sql)) {
    ps.setString(1, name);
    ps.setString(2, description);
    ps.setDouble(3, price);
    ps.setBoolean(4, available);
    ps.setInt(5, id);
    int updated = ps.executeUpdate();
    if (updated == 0) {
        throw new RuntimeException("Aucun item trouvé avec id=" + id);
    }

} catch (SQLException e) {
    throw new RuntimeException("Erreur SQL updateMenuItemBasic()", e);
}
]]></ATT>
                  <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
                  <ATT name="Name"></ATT>
                  <ATT name="status">1970354901745664</ATT>
                </ATTRIBUTES>
                <DEPENDENCIES>
                  <LINK relation="Model">
                    <FOREIGNID name="JavaCode" mc="Infrastructure.NoteType" uid="003800a8-0000-018e-0000-000000000000"/>
                  </LINK>
                </DEPENDENCIES>
              </OBJECT>
            </COMP>
          </DEPENDENCIES>
        </OBJECT>
