            " is_available, is_spicy, is_vegetarian, protein_required" +
            " FROM menu_items" +
            " ORDER BY id";
    return queryList(sqlEng);
} else {
    String sql = "SELECT id, name, description, price, category, image_url, calories," +
            " is_available, is_spicy, is_vegetarian, protein_required" +
            " FROM menu_items" +
            " ORDER BY id";
    return queryList(sql);
}
]]></ATT>
