                <ATTRIBUTES>
                  <ATT name="Content"><![CDATA[return new MenuItem(
                rs.getInt("id"),
                rs.getString("name"),
                rs.getString("description"),
                rs.getString("category"),
                rs.getDouble("price"),
                rs.getString("image_url"),
                rs.getInt("calories"),
                rs.getInt("is_available") == 1,
                rs.getInt("is_spicy") == 1,
